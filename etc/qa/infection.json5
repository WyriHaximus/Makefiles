{
    "threads": 64,
    "timeout": 120,
    "source": {
        "directories": [
            "../../src"
        ]
    },
    "logs": {
        "text": "../../var/infection.log",
        "summary": "../../var/infection-summary.log",
        "json": "../../var/infection.json",
        "perMutator": "../../var/infection-per-mutator.md",
        "github": true
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "ignoreMsiWithNoMutations": true,
    "mutators": {
        "@default": true,
        "BitwiseOr": {
            "ignore": [
                "WyriHaximus\\Makefiles\\Composer\\Installer\\RequirementsCollector::retrieveRequiredPackagesAndExtensions::103"
            ]
        },
        "ReturnRemoval": {
            "ignore": [
                "WyriHaximus\\Makefiles\\Composer\\Installer\\RequirementsCollector::packagesFromVendorComposerJsonNode::118"
            ]
        }
    }
}
